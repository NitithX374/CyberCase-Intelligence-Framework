# Auto detect text files and perform LF normalization
* text=auto
# The claim verifier stamps the SHA-256 of these exact bytes on every verdict, so a checkout must not convert its line endings.
backend/app/trace/b1_lr.json -text
# Research records keep the bytes they were written with, so a checkout must not convert their line endings.
research/analysis_baseline/** -text
research/traceability_properties/** -text
evaluation/ocr_downstream/** -text
